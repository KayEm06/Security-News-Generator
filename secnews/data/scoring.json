    {"id": "T0831", "name": "Manipulation of Control (ICS)", "tactic": "Impact (ICS)", "keywords": ["manipulated setpoints", "changed setpoints", "tampered with HMI", "manipulation of control", "manipulated controllers", "hijacking controllers", "hijacked controllers"]}
