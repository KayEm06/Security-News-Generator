    {"id": "T1189", "name": "Drive-by Compromise", "tactic": "Initial Access", "keywords": ["drive-by", "watering hole", "malvertising", "SEO poisoning"]},
    {"id": "T1200", "name": "Hardware Additions", "tactic": "Initial Access", "keywords": ["hardware implant", "spy chip", "implanted chip", "malicious hardware", "rogue device"]},
    {"id": "T1204", "name": "User Execution", "tactic": "Execution", "keywords": ["ClickFix", "fake CAPTCHA", "FileFix", "fake update", "fake installer", "fake job interview", "fake job interviews"]},
    {"id": "T1059", "name": "Command and Scripting Interpreter", "tactic": "Execution", "keywords": ["PowerShell", "VBScript", "JavaScript payload", "command injection", "malicious script"]},
    {"id": "T1505.003", "name": "Web Shell", "tactic": "Persistence", "keywords": ["webshell", "web shell"]},
