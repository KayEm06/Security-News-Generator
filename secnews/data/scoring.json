    {"id": "T1068", "name": "Exploitation for Privilege Escalation", "tactic": "Privilege Escalation", "keywords": ["privilege escalation", "elevation of privilege", "root access", "gain root", "LPE", "local privilege escalation"]},
    {"id": "T1556", "name": "Modify Authentication Process / MFA bypass", "tactic": "Credential Access", "keywords": ["MFA bypass", "bypass MFA", "bypasses MFA", "2FA bypass", "authentication bypass", "adversary-in-the-middle", "AiTM"]},
